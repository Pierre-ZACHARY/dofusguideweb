  "summaries": [
    {
      "overview": "Pat Akess vous confie une série de six donjons à accomplir dans un ordre imposé. Après chaque victoire, revenez le voir en [5,0] pour obtenir la clef de l'étape suivante. Le parcours vous mène successivement au Scarabosse Doré, au Coffre des Forgerons, à la Bworkette, à la Shin Larve, au Rakoopeur puis au Craqueleur Légendaire. Une fois la série terminée, rendez-vous auprès de Chris de Naire pour conclure la quête.",
      "recommendedLevel": 30,
      "prerequisites": [
        "Être de niveau supérieur à 29.",
        "Avoir terminé la quête Le maître des clefs."
      ],
      "rewards": [
        "3 303 660 XP.",
        "54 192 Kamas.",
        "1 x Viscères du Scarabosse Doré.",
        "1 x Poil de Bworkette.",
        "1 x Dent de Shin Larve.",
        "1 x Méga Pierre du Craqueleur Légendaire."
      ],
      "preparation": [
        "Prévoir de terminer le Donjon des Scarafeuilles.",
        "Prévoir de terminer le Donjon des Forgerons.",
        "Prévoir de terminer le Donjon des Bworks.",
        "Prévoir de terminer le Donjon des Larves.",
        "Prévoir de terminer le Refuge Sylvestre.",
        "Prévoir de terminer les Pitons Rocheux des Craqueleurs."
      ],
      "actions": [
        {
          "instruction": "Parlez à Pat Akess et choisissez « Merci, c’est exactement ce qu’il me faut » pour commencer la quête.",
          "position": "[5,0]",
          "zoneHint": "Village d'Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Terminez le Donjon des Scarafeuilles et vainquez le Scarabosse Doré.",
          "position": "[1,26]",
          "zoneHint": null,
          "warning": "Combat de donjon obligatoire contre le Scarabosse Doré.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retournez voir Pat Akess afin de recevoir la clef du prochain donjon.",
          "position": "[5,0]",
          "zoneHint": "Village d'Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Terminez le Donjon des Forgerons et vainquez le Coffre des Forgerons.",
          "position": "[13,21]",
          "zoneHint": null,
          "warning": "Combat de donjon obligatoire contre le Coffre des Forgerons.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retournez auprès de Pat Akess pour obtenir la clef suivante.",
          "position": "[5,0]",
          "zoneHint": "Village d'Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Terminez le Donjon des Bworks et vainquez la Bworkette.",
          "position": "[-5,10]",
          "zoneHint": null,
          "warning": "Combat de donjon obligatoire contre la Bworkette.",
          "combat": "GROUP"
        },
        {
          "instruction": "Revenez voir Pat Akess pour récupérer la prochaine clef.",
          "position": "[5,0]",
          "zoneHint": "Village d'Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Terminez le Donjon des Larves et vainquez la Shin Larve.",
          "position": "[-2,-5]",
          "zoneHint": null,
          "warning": "Combat de donjon obligatoire contre la Shin Larve.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retournez auprès de Pat Akess afin qu'il vous remette la clef suivante.",
          "position": "[5,0]",
          "zoneHint": "Village d'Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Rendez-vous sur l'archipel de Valonia, terminez le Refuge Sylvestre et vainquez le Rakoopeur. L'archipel est accessible en bateau depuis Amakna en [10,-3].",
          "position": "[40,-84]",
          "zoneHint": "Archipel de Valonia",
          "warning": "Combat de donjon obligatoire contre le Rakoopeur.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retournez voir Pat Akess pour recevoir la dernière clef.",
          "position": "[5,0]",
          "zoneHint": "Village d'Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Terminez les Pitons Rocheux des Craqueleurs et vainquez le Craqueleur Légendaire.",
          "position": "[-3,-7]",
          "zoneHint": null,
          "warning": "Combat de donjon obligatoire contre le Craqueleur Légendaire.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retournez auprès de Pat Akess. Il n'a plus de donjon à vous confier et vous envoie vers un autre interlocuteur.",
          "position": "[5,0]",
          "zoneHint": "Village d'Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Chris de Naire et choisissez « Calmez-vous, je m’en vais » pour terminer la quête.",
          "position": "[-29,-47]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "La quête débloque ensuite Un juge hystérique.",
        "Les six donjons doivent être accomplis dans l'ordre indiqué, avec un retour auprès de Pat Akess entre chaque étape."
