  "summaries": [
    {
      "overview": "Terminez la mission confiée par Amayiro en réunissant exactement 32 dents de Chafer, puis remettez-les à Ned Etsith à Bonta. Chaque Chafer admissible fournit une dent à 100 %, mais dépasser 32 dents oblige à recommencer la collecte.",
      "recommendedLevel": 34,
      "prerequisites": [
        "Du pain pour les braves."
      ],
      "rewards": [
        "108 862 XP."
      ],
      "preparation": [
        "Prévoir des combats contre exactement 32 Chafers.",
        "Surveiller précisément le nombre de Dents de Chafer obtenues afin de ne jamais dépasser 32."
      ],
      "actions": [
        {
          "instruction": "Affrontez des Chafers jusqu'à obtenir exactement 32 Dents de Chafer. Les variantes citées sont les Chafers simple, fantassin, invisible, primitif, lancier, draugr, d'élite, archer ainsi que le boss Rönin. Ils peuvent notamment être trouvés au Cimetière des Héros, au Bois de Litneg, au Cimetière d'Amakna et au Cimetière des Torturés.",
          "position": null,
          "zoneHint": null,
          "warning": "Vous devez obtenir exactement 32 dents. Si vous dépassez ce total, la collecte doit être recommencée à zéro.",
          "combat": "GROUP"
        },
        {
          "instruction": "Une fois les 32 Dents de Chafer réunies, rendez-vous auprès de Ned Etsith et remettez-lui la totalité des dents pour fabriquer le dentier destiné au milicien Tarche.",
          "position": "[-30,-52]",
          "zoneHint": "Bonta",
          "warning": "Ne rendez cette étape qu'avec exactement 32 Dents de Chafer.",
          "combat": "NONE"
        }
      ],
      "notes": [
        "Le taux d'obtention des Dents de Chafer est de 100 % de base.",
        "Placer les Dents de Chafer dans la barre de raccourcis permet de suivre rapidement le compteur.",
        "Cette étape clôt « Ned le dentiste » et débloque ensuite « Entraînement avec Torche »."
      ],
