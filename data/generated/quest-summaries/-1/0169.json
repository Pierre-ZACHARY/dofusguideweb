  "summaries": [
    {
      "overview": "Poursuivez La Grafioze depuis Amayiro : enquêtez auprès de Danathor puis de Touh Flowa, entrez dans la prison végétale avec l'aide d'un Sadida, franchissez ses grilles en sacrifiant les ressources demandées, remportez trois combats, récupérez le Vieux Grimoire Bwork et rapportez-le à Danathor. Cette quête doit être achevée avant de poursuivre Attaque à retardement.",
      "recommendedLevel": 139,
      "prerequisites": [
        "Avoir terminé Trâknar.",
        "Avoir La Grafioze en cours.",
        "Disposer d'un Sadida pour ouvrir la première grille ; votre propre personnage convient s'il est Sadida."
      ],
      "rewards": [
        "10 321 481 XP.",
        "2 000 kamas remis par Danathor à la fin de la mission."
      ],
      "preparation": [
        "Prévoir 2 x Ailes de Scarafeuille Blanc.",
        "Prévoir 2 x Ailes de Scarafeuille Rouge.",
        "Prévoir 1 x Poudre de Perlinpainpain.",
        "Prévoir 1 x Patte d'Arakne Majeure.",
        "Prévoir 1 x Ambre.",
        "Prévoir l'aide d'un Sadida si votre personnage ne l'est pas.",
        "Préparer un groupe si souhaité : les 3 combats peuvent être réalisés à plusieurs."
      ],
      "actions": [
        {
          "instruction": "À la Milice de Bonta, parlez à Amayiro pour poursuivre la mission ; il vous envoie auprès de Danathor.",
          "position": "[-32,-57]",
          "zoneHint": "Milice de Bonta",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Au Palais de Bonta, parlez à Danathor. Il vous dirige vers un Sadida d'Astrub susceptible de connaître l'emplacement du grimoire du bwork mage.",
          "position": "[-36,-60]",
          "zoneHint": "Palais de Bonta",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Touh Flowa pour obtenir l'emplacement de la prison végétale qui renferme le grimoire.",
          "position": "[1,-18]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Rendez-vous en [-12,-6] et entrez dans la grotte menant à la prison végétale.",
          "position": "[-12,-6]",
          "zoneHint": "Prison végétale",
          "warning": "Vérifiez avant d'entrer que vous avez toutes les ressources prévues et un Sadida disponible.",
          "combat": "NONE"
        },
        {
          "instruction": "Dans la première salle, placez un Sadida sur la dalle afin d'ouvrir la grille, puis franchissez-la.",
          "position": "[-12,-6]",
          "zoneHint": "Prison végétale",
          "warning": "Au-delà de cette grille, l'accès est réservé aux personnages ayant cette quête en cours ou l'ayant déjà terminée.",
          "combat": "NONE"
        },
        {
          "instruction": "Après la grille, remportez le premier combat contre les créatures de la prison végétale.",
          "position": "[-12,-6]",
          "zoneHint": "Prison végétale",
          "warning": "Le combat peut être effectué en groupe. Certaines créatures invoquent des Flammèches qui viennent exploser au corps à corps.",
          "combat": "GROUP"
        },
        {
          "instruction": "Dans la salle suivante, activez les quatre socles en cliquant dessus : chacun consomme l'Aile de Scarafeuille Rouge ou l'Aile de Scarafeuille Blanc correspondant à sa couleur. Une fois les 4 socles actifs, placez-vous sur la dalle et franchissez la grille.",
          "position": "[-12,-6]",
          "zoneHint": "Prison végétale",
          "warning": "Cette ouverture consomme au total 2 x Ailes de Scarafeuille Blanc et 2 x Ailes de Scarafeuille Rouge.",
          "combat": "NONE"
        },
        {
          "instruction": "Dans la salle suivante, remportez le deuxième combat.",
          "position": "[-12,-6]",
          "zoneHint": "Prison végétale",
          "warning": "Le combat peut être effectué en groupe. Les adversaires disposent notamment de retraits de PA, d'invocations, de poussées et de malus de résistances.",
          "combat": "GROUP"
        },
        {
          "instruction": "Dans la nouvelle salle à dalles, cliquez sur les trois socles pour les activer avec la Poudre de Perlinpainpain, l'Ambre et la Patte d'Arakne Majeure, puis placez-vous sur la dalle pour ouvrir la grille et passez-la.",
          "position": "[-12,-6]",
          "zoneHint": "Prison végétale",
          "warning": "L'activation des trois socles consomme 1 x Poudre de Perlinpainpain, 1 x Ambre et 1 x Patte d'Arakne Majeure.",
          "combat": "NONE"
        },
        {
          "instruction": "Après la dernière grille, remportez le troisième combat.",
          "position": "[-12,-6]",
          "zoneHint": "Prison végétale",
          "warning": "Le combat peut être effectué en groupe. La version actuelle comporte 3 monstres ; surveillez notamment Lancer d'Arakne Morte, qui frappe dans l'élément air et peut retirer des PM.",
          "combat": "GROUP"
        },
        {
          "instruction": "Une fois le combat gagné, cliquez sur le livre au centre de la pièce pour récupérer le Vieux Grimoire Bwork.",
          "position": "[-12,-6]",
          "zoneHint": "Prison végétale",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retournez voir Danathor et remettez-lui le Vieux Grimoire Bwork pour terminer La Grafioze.",
          "position": "[-36,-60]",
          "zoneHint": "Palais de Bonta",
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "La Grafioze est la quête d'alignement 59 et précède directement Attaque à retardement.",
        "Les ressources servant aux socles sont consommées lors de l'ouverture des grilles.",
        "Les combats de la prison végétale sont tous réalisables en groupe."
      ],
