    {
      "overview": "Poursuis la mission du Major Qiu en Enutrosor : équipe son Cracheur, teste-le successivement sur trois phorreurs de la Carrière Aurifière, puis rapporte les trois résultats à Maximilio au Creuset des Fortunés. Les interactions avec les phorreurs peuvent déclencher des agressions.",
      "recommendedLevel": 150,
      "prerequisites": [
        "Niveau recommandé : 150.",
        "Avoir obtenu le Cracheur du Major Qiu et être à l'étape des tests en Enutrosor."
      ],
      "rewards": [
        "2 215 500 XP.",
        "25 480 kamas.",
        "30 x Orichor.",
        "5 x Œil de Phozami."
      ],
      "preparation": [
        "Équiper le Cracheur du Major Qiu en tant que Corps à Corps avant de commencer les tests.",
        "Prévoir de pouvoir gérer des combats aléatoires lors des interactions avec les phorreurs."
      ],
      "actions": [
        {
          "instruction": "Dans la Carrière Aurifière, parle au Jeune Phorrêveur pour effectuer le premier test avec le Cracheur du Major Qiu équipé.",
          "position": "[0,-5]",
          "zoneHint": "Carrière Aurifière",
          "warning": "L'interaction peut provoquer une agression.",
          "combat": "CHOICE"
        },
        {
          "instruction": "Parle au Phozami Mature pour réaliser le deuxième test du Cracheur.",
          "position": "[2,-3]",
          "zoneHint": "Carrière Aurifière",
          "warning": "Le Phozami Mature peut t'agresser pendant le test.",
          "combat": "CHOICE"
        },
        {
          "instruction": "Parle au Vieux Métaphorreur pour effectuer le troisième et dernier test.",
          "position": "[3,-3]",
          "zoneHint": "Carrière Aurifière",
          "warning": "Le Vieux Métaphorreur peut t'agresser pendant le test.",
          "combat": "CHOICE"
        },
        {
          "instruction": "Une fois les trois Rapports de Test obtenus, rends-toi auprès de Maximilio et donne-lui les résultats pour terminer la quête.",
          "position": "[-1,-1]",
          "zoneHint": "Creuset des Fortunés",
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "Les trois tests doivent être réalisés avant le retour auprès de Maximilio."
      ],
      "npcs": [
        "Jeune Phorrêveur",
        "Phozami Mature",
        "Vieux Métaphorreur",
        "Professeur Maximilio",
        "Major Qiu"
      ],
