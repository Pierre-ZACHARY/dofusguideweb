      "prerequisites": [
        "Poison de scorbute pour la prison."
      ],
      "rewards": [
        "176 791 XP."
      ],
      "preparation": [
        "Avant le défi, disposer de plus de 10,5 fois votre niveau en points d'énergie afin d'éviter la transformation en fantôme après l'abandon."
      ],
      "actions": [
        {
          "instruction": "À la milice de Bonta, parlez à Amayiro et acceptez de défier son neveu en faisant volontairement en sorte de perdre.",
