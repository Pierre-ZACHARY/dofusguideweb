      "prerequisites": [
        "Le décès de Rimaraf.",
        "Avoir terminé ou au minimum lancé Où est passée la 7e compagnie ?."
      ],
      "rewards": [
        "1 360 666 XP."
      ],
      "preparation": [
        "Avoir vaincu Nelween dans le Laboratoire de Brumen Tinctorias sans avoir quitté la salle de sortie."
      ],
      "actions": [
        {
          "instruction": "Dans la salle de sortie du Laboratoire de Brumen Tinctorias, cliquez sur le tube phosphorescent situé en haut à droite afin de récupérer le Venin de scorbute.",
