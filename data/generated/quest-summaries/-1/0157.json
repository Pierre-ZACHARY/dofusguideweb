      "preparation": [],
      "actions": [
        {
          "instruction": "Après avoir vaincu El Piko dans la Caverne d’El Piko, parlez à Airen Kraken, le Steamer disparu, afin de le libérer.",
          "position": "[15,-65]",
          "zoneHint": "Caverne d’El Piko",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retrouvez Airen Kraken devant son vaisseau et acceptez de l’aider à récupérer la boîte noire.",
          "position": "[13,-58]",
          "zoneHint": "Dunes des ossements",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à ERDE et lancez le processus de déverrouillage de la boîte noire. Sélectionnez ensuite, dans cet ordre exact : « X-Fin », « Modèle 5T4R édition W4R2 », puis « R383773 ».",
          "position": "[13,-58]",
          "zoneHint": "Dunes des ossements",
          "warning": "Respectez exactement l’ordre des trois réponses du système de déverrouillage.",
          "combat": "NONE"
        },
        {
          "instruction": "Reparlez à Airen Kraken et indiquez-lui qu’il peut extraire la boîte noire en toute sécurité pour terminer L'Étoile de la Mer.",
          "position": "[13,-58]",
          "zoneHint": "Dunes des ossements",
          "warning": null,
          "combat": "NONE"
        }
      ],
