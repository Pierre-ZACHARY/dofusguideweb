      "questKey": "quest:939",
      "sourceUrl": "https://www.dofuspourlesnoobs.com/bas-les-masques.html",
      "sourceTitle": "Bas les masques",
      "sourceHash": "1c35efb29f99f7b4082829044b98a24d401ee226c1fcf3c8dc157b0c2c06d29e",
