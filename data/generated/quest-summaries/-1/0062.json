  "summaries": [
    {
      "overview": "Aidez Gropinson Cruaulé à préparer une lotion répulsive contre les Kannibouls afin de poursuivre la recherche du Dokoko. Vous devrez récolter plusieurs ingrédients sur la Plage de la Tortue, vaincre des Grokoko pour faire apparaître un vieux Grokoko, puis rapporter sa feuille à Gropinson.",
      "recommendedLevel": 50,
      "prerequisites": [
        "Partir un jour sans retour."
      ],
      "rewards": [
        "203 765 XP.",
        "3 480 kamas.",
        "3 x Kokopaille.",
        "3 x Lait de Tortue."
      ],
      "preparation": [
        "Prévoir des combats sur la Plage de la Tortue.",
        "Obtenir 4 x Pulpe macérée de nodkoko sur les Nodkoko, avec un taux de drop de base de 50%.",
        "Obtenir 4 x Huile de foie de tortue sur les Tortues de la plage, avec un taux de drop de base de 50%.",
        "Récolter les feuilles de salace marine aux positions [34,12], [32,11], [34,5] et [36,5]."
      ],
      "actions": [
        {
          "instruction": "Depuis l'employée de l'agence Touriste, allez sur la carte de gauche et parlez à Gropinson Cruaulé. Proposez-lui de vous associer à lui pour rechercher le Dokoko.",
          "position": "[33,12]",
          "zoneHint": "Plage de la Tortue",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Combattez les Nodkoko jusqu'à obtenir 4 x Pulpe macérée de nodkoko.",
          "position": null,
          "zoneHint": "Plage de la Tortue",
          "warning": "Le taux de drop de base est de 50%.",
          "combat": "GROUP"
        },
        {
          "instruction": "Combattez les Tortues de la plage jusqu'à obtenir 4 x Huile de foie de tortue.",
          "position": null,
          "zoneHint": "Plage de la Tortue",
          "warning": "Le taux de drop de base est de 50%.",
          "combat": "GROUP"
        },
        {
          "instruction": "Récoltez une feuille de salace marine à cet emplacement.",
          "position": "[34,12]",
          "zoneHint": "Plage de la Tortue",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Récoltez une feuille de salace marine à cet emplacement.",
          "position": "[32,11]",
          "zoneHint": "Plage de la Tortue",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Récoltez une feuille de salace marine à cet emplacement.",
          "position": "[34,5]",
          "zoneHint": "Plage de la Tortue",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Récoltez une feuille de salace marine à cet emplacement.",
          "position": "[36,5]",
          "zoneHint": "Plage de la Tortue",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retournez voir Gropinson Cruaulé et donnez-lui tous les ingrédients nécessaires à la lotion.",
          "position": "[33,12]",
          "zoneHint": "Plage de la Tortue",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Tuez 3 Grokoko sur la plage afin de faire sortir un vieux Grokoko de sa cachette.",
          "position": null,
          "zoneHint": "Plage de la Tortue",
          "warning": "Les 3 Grokoko doivent être vaincus avant de pouvoir trouver le vieux Grokoko.",
          "combat": "GROUP"
        },
        {
          "instruction": "Rendez-vous auprès du vieux Grokoko et attaquez-le.",
          "position": "[32,7]",
          "zoneHint": "Plage de la Tortue",
          "warning": "Le combat peut être réalisé à plusieurs.",
          "combat": "GROUP"
        },
        {
          "instruction": "Après la victoire, récupérez la Feuille de vieux grokoko obtenue en fin de combat.",
          "position": "[32,7]",
          "zoneHint": "Plage de la Tortue",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retournez auprès de Gropinson Cruaulé et montrez-lui la Feuille de vieux grokoko. Il vous remet sa lotion, que vous devez appliquer sur tout votre corps.",
          "position": "[33,12]",
          "zoneHint": "Plage de la Tortue",
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "La quête se termine après l'application de la lotion.",
        "En poursuivant la conversation avec Gropinson Cruaulé, vous débloquez Un indigeste chez les indigènes."
      ],
