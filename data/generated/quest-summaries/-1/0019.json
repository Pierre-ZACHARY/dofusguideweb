          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à la Milicienne de Bonta afin d'écouter sa présentation de Bonta et de sa milice. La quête se termine après avoir rencontré les deux recruteuses.",
          "position": "[1,-18]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        }
