    {
      "overview": "À la suite de Six pieds sous terre, Kerubim Crépin élabore un piège pour attirer l'escroc en faisant croire que vous souhaitez acheter une statue du temple. Après avoir répandu la rumeur et recruté un Investigateur Amaknéen, vous capturez Hippolyte Hique et le livrez à Badufron.",
      "recommendedLevel": 25,
      "prerequisites": [
        "Six pieds sous terre."
      ],
      "rewards": [
        "25 013 XP.",
        "552 kamas.",
        "2 x Crocs de Rats.",
        "2 x Cuir de Scélérat Strubien."
      ],
      "preparation": [],
      "actions": [
        {
          "instruction": "Parlez à Kerubim Crépin à la suite de Six pieds sous terre et acceptez son plan consistant à vous faire passer pour un acheteur de statue du temple.",
          "position": "[3,-17]",
          "zoneHint": "Cité d'Astrub",
          "warning": "La quête nécessite d'avoir terminé Six pieds sous terre.",
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Prim et expliquez que vous avez besoin d'affiches et de prospectus. Il accepte de préparer et placarder la publicité.",
          "position": "[7,-19]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Sel Dawa pour lancer la rumeur concernant votre prétendu achat d'une statue.",
          "position": "[6,-18]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Shani Sings pour continuer à répandre la rumeur.",
          "position": "[6,-15]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Alberta Borida pour terminer la diffusion de la rumeur.",
          "position": "[1,-21]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Trouvez l'Investigateur Amaknéen et demandez-lui de vous accompagner. Il peut être rencontré en [3,-21], [1,-17], [7,-15] ou [7,-19].",
          "position": null,
          "zoneHint": "Cité d'Astrub",
          "warning": "L'Investigateur Amaknéen peut se trouver à plusieurs positions : [3,-21], [1,-17], [7,-15] ou [7,-19].",
          "combat": "NONE"
        },
        {
          "instruction": "Devant le temple, parlez à Hippolyte Hique, qui prétend gérer le patrimoine religieux d'Astrub. Lorsqu'il aborde le prix de vente, faites intervenir vos complices.",
          "position": "[6,-19]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à l'Investigateur Amaknéen pour le convaincre de régler l'affaire à la milice.",
          "position": "[6,-19]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Reparlez à Hippolyte Hique afin de le conduire à la milice.",
          "position": "[6,-19]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Livrez Hippolyte Hique à Badufron. Vous apprenez qu'il s'appelle en réalité Victor, ancien comte de Lustig déchu pour fabrication de fausse monnaie.",
          "position": "[5,-19]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Descendez dans le sous-sol de la milice et parlez à Hippolyte Hique désormais emprisonné. La quête se termine.",
          "position": "[5,-19]",
          "zoneHint": "Sous-sol de la milice",
          "warning": "Cette dernière action se déroule dans le sous-sol de la milice, pas à l'extérieur.",
          "combat": "NONE"
        }
