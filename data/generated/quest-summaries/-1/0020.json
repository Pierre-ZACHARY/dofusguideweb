  "summaries": [
    {
      "overview": "Badufron vous confie quatre missions de mercenaire à accomplir auprès de quatre habitants d'Astrub et de ses environs. La quête reste ouverte pendant que vous terminez Les as de la cambriole, Déjeuner à la fourchette, Comme un pichon hors de l'eau et La coupe des vices, puis se conclut en faisant votre rapport à Badufron.",
      "recommendedLevel": 20,
      "prerequisites": [
        "Niveau recommandé : 20-40.",
        "Avoir terminé Bière qui roule n'amasse pas mousse."
      ],
      "rewards": [
        "254 268 XP.",
        "4 760 kamas.",
        "4 x Antennes de Vilinsekt.",
        "Déblocage du succès Mercenaire d’acier."
      ],
      "preparation": [
        "Prévoir de réaliser quatre quêtes distinctes avant de pouvoir rendre Combat de rue."
      ],
      "actions": [
        {
          "instruction": "Parlez à Badufron, acceptez de poursuivre les missions et prenez la liste des personnes à aider.",
          "position": "[5,-19]",
          "zoneHint": "Cité d'Astrub",
          "warning": "Cette quête exige l'accomplissement de quatre autres quêtes avant son rendu.",
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Cindy Cah et accomplissez la quête Les as de la cambriole.",
          "position": "[5,-17]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Vaiguy et accomplissez la quête Déjeuner à la fourchette.",
          "position": "[5,-22]",
          "zoneHint": "Cité d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Bart Cousti et accomplissez la quête Comme un pichon hors de l'eau.",
          "position": "[11,-24]",
          "zoneHint": "Calanques d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Jeffrey Baratourte et accomplissez la quête La coupe des vices.",
          "position": "[2,-31]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Lorsque les quatre missions sont terminées, retournez auprès de Badufron et faites-lui votre rapport pour achever la quête.",
          "position": "[5,-19]",
          "zoneHint": "Cité d'Astrub",
          "warning": "Le rendu n'est possible qu'après validation des quatre quêtes demandées.",
          "combat": "NONE"
        }
      ],
      "notes": [
        "Comme un pichon hors de l'eau constitue l'une des quatre étapes nécessaires à Combat de rue.",
        "Les trois autres quêtes demandées ne disposent pas de contenu source dans l'étape actuelle et ne sont donc pas détaillées ici."
      ],
