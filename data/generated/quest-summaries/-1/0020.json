        {
          "instruction": "Dans les Calanques d'Astrub, vainquez 3 x Pichon Blanc, 3 x Pichon Bleu, 3 x Pichon Orange et 3 x Pichon Vert.",
          "position": null,
          "zoneHint": "Calanques d'Astrub",
          "warning": "Les quatre séries de trois pichons doivent toutes être complétées.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retournez auprès de Bart Cousti pour annoncer que les pichons demandés ont été vaincus et récupérer la Clef du Château Ensablé.",
          "position": "[11,-24]",
          "zoneHint": "Calanques d'Astrub",
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
