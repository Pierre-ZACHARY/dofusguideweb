      "prerequisites": [
        "Niveau recommandé : 50."
      ],
      "rewards": [
        "203 765 XP.",
        "3 480 kamas.",
        "3 x Sceau Royal Contrefait."
      ],
      "preparation": [
        "Prévoir plusieurs combats contre les Bandits du clan des roublards.",
        "Les objets recherchés ont chacun un taux d'obtention de base compris entre 10 et 14 %."
      ],
      "actions": [
        {
          "instruction": "Parler à Edgar Davou pour demander votre chemin et apprendre que les vols sont attribués aux Bandits du clan des roublards.",
