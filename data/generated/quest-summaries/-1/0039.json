  "summaries": [
    {
      "overview": "Aidez à sécuriser et réparer l'accès à Pandala, faites préparer un sérum contre la Pandrista puis traversez le pont. Une fois sur l'île, buvez le lait de bambou fermenté proposé par le Garde Chopynju afin de percevoir les esprits et rencontrer Doukwang.",
      "recommendedLevel": 30,
      "prerequisites": [
        "Niveau recommandé : 30."
      ],
      "rewards": [
        "71 795 XP.",
        "1 480 Kamas."
      ],
      "preparation": [
        "5 x Laine de Boufton Noir.",
        "50 x Ortie.",
        "Prévoir des combats contre les monstres de la Carrière d'Astrub."
      ],
      "actions": [
        {
          "instruction": "Parlez à Moktwa devant le pont d'accès à Pandala pour lancer la quête et accepter de repousser les Sidoas qui gênent les ouvriers.",
          "position": "[12,-21]",
          "zoneHint": "Carrière d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Dans la Carrière d'Astrub, battez exactement 5 Martoa, 5 Sherpoa, 5 Douzdoa et 5 Pikdoa.",
          "position": null,
          "zoneHint": "Carrière d'Astrub",
          "warning": "Il faut vaincre 5 exemplaires de chacun des quatre types de Sidoas demandés.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retournez voir Moktwa après avoir rempli les quatre objectifs de combat. Il vous recommande alors de vous faire vacciner contre la Pandrista avant de traverser.",
          "position": "[12,-21]",
          "zoneHint": "Carrière d'Astrub",
          "warning": "Le vaccin doit être obtenu avant la traversée vers Pandala.",
          "combat": "NONE"
        },
        {
          "instruction": "Entrez dans le dispensaire et parlez à Nepra Lido pour demander un sérum contre la Pandrista. Son stock étant vide, elle vous envoie chercher une autre solution.",
          "position": "[3,-21]",
          "zoneHint": "Dispensaire",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Sortez du dispensaire puis entrez dans l'atelier des alchimistes de la même carte. Parlez à Nibé Lulle : il vous demande de réunir les ingrédients nécessaires à la fabrication du sérum.",
          "position": "[3,-21]",
          "zoneHint": "Atelier des alchimistes",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Sel Dawa et demandez à prélever un peu de son sang. Après l'avoir rassuré, vous obtenez 1 Échantillon sanguin de Sel Dawa.",
          "position": "[6,-18]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Dans un atelier des alchimistes, fabriquez 1 Sérum contre la Pandrista avec 5 Laine de Boufton Noir, 50 Ortie et 1 Échantillon sanguin de Sel Dawa.",
          "position": null,
          "zoneHint": "Atelier des alchimistes",
          "warning": "La fabrication consomme 5 Laine de Boufton Noir, 50 Ortie et 1 Échantillon sanguin de Sel Dawa.",
          "combat": "NONE"
        },
        {
          "instruction": "Retournez au dispensaire auprès de Nepra Lido, annoncez que vous avez parlé à Nibé Lulle et faites-vous vacciner avec le sérum fabriqué.",
          "position": "[3,-21]",
          "zoneHint": "Dispensaire",
          "warning": "Cette étape valide la vaccination nécessaire avant l'accès à Pandala.",
          "combat": "NONE"
        },
        {
          "instruction": "Revenez au début du pont puis traversez jusqu'à Pandala et rejoignez le Garde Chopynju.",
          "position": "[19,-28]",
          "zoneHint": "Pandala",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez au Garde Chopynju. Il vous propose de boire une pinte de lait de bambou fermenté afin de vous ouvrir à la perception des esprits.",
          "position": "[19,-28]",
          "zoneHint": "Pandala",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Utilisez la Pinte de lait de bambou fermenté présente dans votre inventaire de quête. Vous perdez connaissance et vous réveillez dans une pièce où un esprit devient visible.",
          "position": null,
          "zoneHint": null,
          "warning": "L'utilisation de la pinte fait avancer immédiatement la quête vers la rencontre avec l'esprit.",
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Doukwang dans la pièce où vous vous réveillez, puis sortez pour vous retrouver devant le Pandazaap et terminer la quête.",
          "position": null,
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "La fin de la quête donne accès à toute l'île de Pandala et à ses quêtes.",
        "La suite de la série principale de Pandala est « À la croisée des mondes »."
      ],
      "npcs": [
        "Moktwa",
        "Nepra Lido",
        "Nibé Lulle",
