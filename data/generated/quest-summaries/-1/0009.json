        {
          "instruction": "Rendez-vous au zaap des Pâturages et parlez à Xélora Fistol pour l'interroger sur l'origine et le fonctionnement des zaaps.",
          "position": "[2,-5]",
          "zoneHint": "Pâturages d'Incarnam",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Examinez le zaap en cliquant dessus après la discussion avec Xélora.",
          "position": "[2,-5]",
          "zoneHint": "Pâturages d'Incarnam",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retournez auprès de Ternette Nhin, soit à pied, soit en utilisant le zaap, puis racontez-lui votre rencontre avec Xélora pour terminer la quête.",
          "position": "[-1,-3]",
          "zoneHint": null,
          "warning": "Le retour par zaap peut entraîner une dépense en kamas ; le trajet à pied évite ce coût.",
          "combat": "NONE"
