      "preparation": [],
      "actions": [
        {
          "instruction": "Parlez à Ternette Nhin et indiquez que vous êtes pressé de découvrir Incarnam. Elle vous explique les principes des zaaps et vous envoie rencontrer Xélora Fistol.",
          "position": "[-1,-3]",
          "zoneHint": null,
          "warning": "Les voyages par zaap peuvent coûter des kamas et un zaap de destination doit avoir été découvert auparavant.",
          "combat": "NONE"
