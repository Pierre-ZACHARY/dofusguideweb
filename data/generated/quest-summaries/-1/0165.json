  "summaries": [
    {
      "overview": "Poursuivez Un cœur d'or jusqu'à sa conclusion : aidez Taupinambourg, rendez plusieurs services dans la Carrière Aurifière et le Creuset des Fortunés, puis revenez auprès de Grabergue pour récupérer le Joyau écarlate et découvrir sa malédiction.",
      "recommendedLevel": 150,
      "prerequisites": [
        "Avoir terminé Les grandes galeries.",
        "La quête Un cœur d'or doit déjà être lancée en ayant utilisé le Joyau écarlate."
      ],
      "rewards": [
        "2 215 500 XP.",
        "25 480 kamas.",
        "30 x Orichor.",
        "5 x Peau de Métaphorreur."
      ],
      "preparation": [
        "Prévoir un combat obligatoire en solitaire contre un Phormidiable blessé."
      ],
      "actions": [
        {
          "instruction": "Parlez à Taupinambourg, proposez votre aide puis affrontez le Phormidiable blessé demandé.",
          "position": "[1,-4]",
          "zoneHint": "Carrière Aurifière",
          "warning": "Le combat contre le Phormidiable blessé doit être effectué seul.",
          "combat": "SOLO"
        },
        {
          "instruction": "Après la victoire, reparlez à Taupinambourg afin de recevoir le message à transmettre à Flemmarcel.",
          "position": "[1,-4]",
          "zoneHint": "Carrière Aurifière",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Flemmarcel afin qu'il vous demande de préparer les boulettes à partir des excréments de Phorreurs.",
          "position": "[0,-3]",
          "zoneHint": "Carrière Aurifière",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Récupérez l'élément interactif lié aux excréments de Phorreurs sur cette carte.",
          "position": "[1,-3]",
          "zoneHint": "Carrière Aurifière",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Récupérez l'élément interactif lié aux excréments de Phorreurs sur cette carte.",
          "position": "[0,-5]",
          "zoneHint": "Carrière Aurifière",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Récupérez le dernier élément interactif lié aux excréments de Phorreurs sur cette carte.",
          "position": "[0,-4]",
          "zoneHint": "Carrière Aurifière",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retournez parler à Flemmarcel pour valider le travail et récupérer le repas chaud à livrer.",
          "position": "[0,-3]",
          "zoneHint": "Carrière Aurifière",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Remettez le repas chaud au Hérault d'Enutrof ; il vous enverra ensuite auprès de Tanguy.",
          "position": "[-5,-5]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Placez votre personnage sur la cellule située devant Tanguy, proposez-lui de danser puis exécutez successivement les mouvements qu'il demande jusqu'à ce qu'il vous envoie voir Chipsou.",
          "position": "[-2,-3]",
          "zoneHint": "Creuset des Fortunés",
          "warning": "Il faut se placer sur la cellule devant Tanguy pour pouvoir interagir correctement avec lui.",
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Chipsou puis cliquez sur les 5 tas de kamas pour les compter.",
          "position": "[1,-5]",
          "zoneHint": "Carrière Aurifière",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Vérifiez ensuite l'authenticité des kamas en utilisant le sac interactif, remettez-les à leur place, puis indiquez à Chipsou qu'ils sont authentiques et donnez-lui le nombre exact compté.",
          "position": "[1,-5]",
          "zoneHint": "Carrière Aurifière",
          "warning": "Le dialogue demande de fournir le nombre exact de kamas constaté pendant l'interaction.",
          "combat": "NONE"
        },
        {
          "instruction": "Revenez auprès de Grabergue et ramassez le Joyau écarlate tombé près de lui, puis parlez-lui pour terminer la quête.",
          "position": "[3,-4]",
          "zoneHint": "Carrière Aurifière",
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "La fin de la quête révèle que le Joyau écarlate est maudit.",
        "Cette conclusion permet d'enchaîner immédiatement avec Maudite générosité dans cette même étape."
      ],
      "npcs": [
        "Taupinambourg",
