  "summaries": [
    {
      "overview": "Kerubim Crépin craint que Gralahad, chasseur de Shushu venu de Bonta, découvre que sa maison est le Shushu Luis. Après avoir espionné Gralahad, vous participez à un stratagème impliquant Gilou Aychwesh et un faux Shushu, puis aidez Gralahad lors d'un combat avant de recevoir un ticket donnant accès aux diligences d'Astrub.",
      "recommendedLevel": 25,
      "prerequisites": [
        "Niveau recommandé : 25.",
        "Avoir terminé « Scène de ménage »."
      ],
      "rewards": [
        "50 026 XP.",
        "1 105 kamas.",
        "Accès aux diligences depuis [0,-18], avec des trajets aller simple vers le Domaine des Fungus [-12,29], la Baie de Cania [-29,-12] et le Cimetière des Héros [-21,-58]."
      ],
      "preparation": [
        "Prévoir 1 x Bière d'Astrub ou 40 kamas pour l'acheter à Tek Abir.",
        "Prévoir un combat réalisable en groupe contre Gilou Aychwesh.",
        "Prévoir un combat seul, avec Gralahad comme allié."
      ],
      "actions": [
        {
          "instruction": "Parlez à Kerubim Crépin et demandez-lui si quelque chose le tracasse, puis acceptez d'enquêter sur la présence de Gralahad à Astrub.",
          "position": "[3,-17]",
          "zoneHint": "Astrub",
          "warning": "La quête nécessite d'avoir terminé « Scène de ménage ».",
          "combat": "NONE"
        },
        {
          "instruction": "Entrez dans la taverne d'Astrub et achetez 1 x Bière d'Astrub à Tek Abir pour 40 kamas si vous n'en avez pas déjà une, puis donnez-la à Gralahad afin qu'il révèle qu'il recherche un Shushu caché à Astrub.",
          "position": "[6,-18]",
          "zoneHint": "Taverne d'Astrub",
          "warning": "Dépense possible : 40 kamas pour 1 x Bière d'Astrub.",
          "combat": "NONE"
        },
        {
          "instruction": "Retournez voir Kerubim Crépin et rapportez-lui la raison de la présence de Gralahad. Il met alors au point un faux Shushu destiné à détourner le chasseur de Luis.",
          "position": "[3,-17]",
          "zoneHint": "Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Gilou Aychwesh pour l'emmener de force avec vous et remportez le combat.",
          "position": "[4,-15]",
          "zoneHint": "Astrub",
          "warning": "Combat réalisable en groupe.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retournez auprès de Kerubim Crépin et poussez Gilou Aychwesh dans la pièce afin de poursuivre le plan d'échange entre la valise du faux Shushu et la capture de Gilou.",
          "position": "[3,-17]",
          "zoneHint": "Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez voir Gralahad et annoncez-lui que le Shushu recherché est apparu dans la maison de Marp.",
          "position": "[6,-18]",
          "zoneHint": "Taverne d'Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Entrez dans la maison de Marp, parlez à Gralahad puis combattez le faux Shushu à ses côtés.",
          "position": "[1,-19]",
          "zoneHint": "Maison de Marp",
          "warning": "Le combat s'effectue seul, mais Gralahad combat à vos côtés.",
          "combat": "SOLO"
        },
        {
          "instruction": "Après le combat, reparlez à Gralahad, puis parlez au tonneau contenant Kerubim Crépin Toflé. Il vous remet un ticket pour les transports.",
          "position": "[1,-19]",
          "zoneHint": "Maison de Marp",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Présentez le ticket de Kerubim Crépin à Hassen Cehef pour terminer la quête et débloquer les diligences.",
          "position": "[0,-18]",
          "zoneHint": "Astrub",
          "warning": "Les diligences permettent des trajets aller simple vers le Domaine des Fungus [-12,29], la Baie de Cania [-29,-12] et le Cimetière des Héros [-21,-58].",
          "combat": "NONE"
        }
      ],
      "notes": [
        "Gilou Aychwesh utilise notamment Délinquance, Lancer de Caillasse et Jvétfumay.",
        "Lors du second combat, le Shushu attaque au contact avec Shushupe ; Gralahad peut donner 3 PM aux alliés avec Volonté Inébranlable et infliger de lourds dégâts avec Koupendeu."
      ],
