  "tips": [
    {
      "title": "Mutualiser le Maître Corbac",
      "description": "Le passage par la Bibliothèque du Maître Corbac sert à la fois à la progression de Le livre des Taures et à celle de Des donjons, encore des donjons. Vérifiez les deux quêtes avant le donjon afin de profiter du même passage.",
      "questKeys": [
        "quest:806",
        "quest:74"
      ],
      "actions": [
        "Avant de quitter la Bibliothèque du Maître Corbac, vérifiez que les objectifs nécessaires à Le livre des Taures ont bien été obtenus.",
        "La victoire contre le Maître Corbac valide simultanément l'objectif correspondant de Des donjons, encore des donjons."
      ]
    },
    {
      "title": "Profiter du passage en [-22,-24]",
      "description": "Ça saute aux oeufs et Chacun cherche son chacha passent toutes deux par [-22,-24]. Lancez la première auprès du Docteur Gaw avant de poursuivre immédiatement la seconde.",
      "questKeys": [
        "quest:947",
        "quest:948"
      ],
      "actions": [
        "En [-22,-24], lancez Ça saute aux oeufs auprès du Docteur Gaw sans commencer la collecte des oeufs.",
        "Enchaînez ensuite avec le Major Qiu pour poursuivre Chacun cherche son chacha."
      ]
    }
  ]
