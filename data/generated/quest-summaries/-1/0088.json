  "tips": [
    {
      "title": "Un seul Antre pour deux quêtes",
      "description": "Comme un corbac sur sa branche et Arak-haï en pagaille passent toutes deux par l’Antre de la Reine Nyée à cette étape. Préparez les deux occurrences avant d’entrer afin de rentabiliser un seul passage.",
      "questKeys": [
        "quest:1405",
        "quest:893"
      ],
      "actions": [
        "Vérifiez que les deux quêtes sont arrivées à leur objectif dans l’Antre de la Reine Nyée.",
        "Faites l’Antre de la Reine Nyée une seule fois.",
        "Pendant ce passage, obtenez l’Oeuf noir pour Comme un corbac sur sa branche et parlez à la Reine Nyée avant de sortir pour Arak-haï en pagaille."
      ]
    },
    {
      "title": "Mutualiser le Domaine Ancestral",
      "description": "Vengeance par procuration doit être mise en attente au boss, puis Munster lève le mystère vous conduit au même Domaine Ancestral. Le même passage permet d’avancer les deux quêtes sans faire le donjon deux fois.",
      "questKeys": [
        "quest:35",
        "quest:894"
      ],
      "actions": [
        "Avancez Vengeance par procuration jusqu’à l’objectif demandant d’arracher son gland à l’Abraknyde Ancestral, sans faire le boss immédiatement.",
        "Avancez ensuite Munster lève le mystère jusqu’au Domaine Ancestral.",
        "Effectuez le Domaine Ancestral pour Munster lève le mystère ; la victoire sur l’Abraknyde Ancestral permet aussi de remplir l’objectif de Vengeance par procuration.",
        "Gardez les rendus et la suite de ces deux quêtes pour leurs occurrences FINISH de l’étape 89."
      ]
    }
  ]
