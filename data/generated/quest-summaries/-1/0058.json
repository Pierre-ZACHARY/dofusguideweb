  "summaries": [
    {
      "overview": "Amayiro vous charge de contacter le fantôme du capitaine Tsog afin de récupérer les informations qu'il voulait transmettre avant sa mort. Après avoir localisé sa tombe dans le Cimetière des Héros et écouté son fantôme, vous devrez retrouver à Sufokia le coffre qu'il a dissimulé, en utilisant impérativement une Pelle de Boisaille équipée avant d'entrer sur la carte concernée, puis rapporter le coffre à Amayiro.",
      "recommendedLevel": 50,
      "prerequisites": [
        "Avoir terminé Le Tabi d'Amayiro."
      ],
      "rewards": [
        "362 568 XP.",
        "Déblocage de l'Alignement 21 : Des anneaux sur le bout des doigts.",
        "Déblocage de l'accès aux trois ordres de niveau 1 : Ordre du Coeur Vaillant, Ordre de l'Oeil Attentif et Ordre de l'Esprit Salvateur."
      ],
      "preparation": [
        "Prévoir 1 x Pelle de Boisaille.",
        "La Pelle de Boisaille peut être achetée ou fabriquée par un forgeron niveau 6 minimum avec 3 x Peau de Gloot et 3 x Bois de Frêne."
      ],
      "actions": [
        {
          "instruction": "Parlez à Amayiro dans la milice de Bonta pour commencer la quête et accepter de rechercher un moyen de contacter le capitaine Tsog.",
          "position": "[-32,-57]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Demandez au Capitaine Alrok où Tsog a été enterré.",
          "position": "[-31,-56]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Rendez-vous à la tombe de Tsog, puis cliquez sur le caveau situé au centre pour descendre.",
          "position": "[-21,-61]",
          "zoneHint": "Cimetière des Héros",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Dans le caveau de Tsog, placez-vous exactement sur la même cellule que le fantôme de Tsog afin de pouvoir écouter ses paroles, puis parlez-lui pour obtenir les Paroles de Tsog et apprendre qu'un coffre est caché à Sufokia.",
          "position": "[-21,-61]",
          "zoneHint": "Caveau de Tsog",
          "warning": "Il faut être placé exactement sur la cellule du fantôme pour pouvoir progresser.",
          "combat": "NONE"
        },
        {
          "instruction": "Procurez-vous 1 x Pelle de Boisaille si vous ne l'avez pas encore, puis rendez-vous en [22,21] via le zaapi du Quai de la voie du temple.",
          "position": "[22,21]",
          "zoneHint": "Quai de la voie du temple",
          "warning": "La Pelle de Boisaille doit être équipée à la place de votre arme avant d'arriver sur la carte contenant l'urne.",
          "combat": "NONE"
        },
        {
          "instruction": "Depuis le zaapi, montez d'une carte, entrez dans le tunnel et avancez encore d'une carte.",
          "position": null,
          "zoneHint": "Tunnel",
          "warning": "N'entrez pas sur la carte finale sans avoir déjà équipé la Pelle de Boisaille, sinon l'urne ne pourra pas être utilisée.",
          "combat": "NONE"
        },
        {
          "instruction": "Cliquez sur l'urne pour récupérer le Coffre caché de Tsog.",
          "position": null,
          "zoneHint": "Tunnel",
          "warning": "La Pelle de Boisaille doit avoir été équipée avant l'arrivée sur cette carte.",
          "combat": "NONE"
        },
        {
          "instruction": "Retournez voir Amayiro et remettez-lui le Coffre caché de Tsog pour terminer la quête.",
          "position": "[-32,-57]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "La quête suit directement Le Tabi d'Amayiro et précède Des anneaux sur le bout des doigts.",
        "Les trois quêtes d'apprentissage d'ordre débloquées sont Apprentissage : Disciple de Ménalt, Apprentissage : Disciple de Silvosse et Apprentissage : Disciple de Jiva."
      ],
