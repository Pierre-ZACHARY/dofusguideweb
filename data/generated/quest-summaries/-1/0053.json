  "summaries": [
    {
      "overview": "Aidez Steff Taff à retrouver ses souvenirs. Après lui avoir apporté une Pomme, récupérez trois de ses anciennes créations dispersées dans la région, en affrontant les créatures qui les protègent, puis rapportez-les-lui.",
      "recommendedLevel": 30,
      "prerequisites": [
        "Mieux vaut ne pas se fier à la première impression."
      ],
      "rewards": [
        "71 795 XP.",
        "1 480 kamas.",
        "Masque de Taff."
      ],
      "preparation": [
        "Prévoir 1 x Pomme.",
        "Prévoir trois combats."
      ],
      "actions": [
        {
          "instruction": "Parlez à Steff Taff pour lancer la quête. Il vous demande de lui procurer une Pomme afin de raviver ses souvenirs.",
          "position": "[7,25]",
          "zoneHint": "Sufokia",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Procurez-vous 1 x Pomme, notamment via l'hôtel de vente ou comme récompense des quêtes Charger la mule, Épicerie fine ou Course polaire, puis remettez-la à Steff Taff.",
          "position": "[7,25]",
          "zoneHint": "Sufokia",
          "warning": "La Pomme doit être obtenue avant de poursuivre.",
          "combat": "NONE"
        },
        {
          "instruction": "Cliquez sur la roche située en bas à gauche de la zone pour récupérer un Skarab. Un Mal de Kwoan vous attaque immédiatement.",
          "position": "[1,26]",
          "zoneHint": null,
          "warning": "Combat obligatoire contre un Mal de Kwoan. Céphaleine inflige des dégâts air ; Migre Haine inflige des dégâts feu et peut retirer 2 PM esquivables.",
          "combat": "SOLO"
        },
        {
          "instruction": "Cliquez sur la cage en bois située sous le chacha rose pour récupérer une Ardoiz. Un nouveau Mal de Kwoan vous attaque.",
          "position": "[9,21]",
          "zoneHint": null,
          "warning": "Combat obligatoire contre un Mal de Kwoan.",
          "combat": "SOLO"
        },
        {
          "instruction": "Entrez par l'ouverture au pied de la statue Wabbit en haut à gauche, descendez puis cliquez sur la petite statue Wabbit près du gros trou afin d'obtenir une Pierre Spécieuse.",
          "position": "[7,16]",
          "zoneHint": null,
          "warning": "Après avoir récupéré la Pierre Spécieuse, un combat obligatoire se lance contre deux Mal de Kwoan.",
          "combat": "SOLO"
        },
        {
          "instruction": "Retournez auprès de Steff Taff et remettez-lui le Skarab, l'Ardoiz et la Pierre Spécieuse. Ses souvenirs reviennent et la quête se termine.",
          "position": "[7,25]",
          "zoneHint": "Sufokia",
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [],
      "npcs": [
        "Steff Taff"
      ],
