    {
      "overview": "Le Capitaine Kradoc accepte de préparer son navire pour un voyage vers l'île d'Otomaï à condition que vous lui fournissiez les ressources nécessaires à l'armement et à son repas.",
      "recommendedLevel": 35,
      "prerequisites": [],
      "rewards": [
        "95 458 XP.",
        "1 905 kamas."
      ],
      "preparation": [
        "Prévoir 2 x Miséricorde du Chafer d'Élite.",
        "Prévoir 1 x Gros Boulet.",
        "Prévoir 1 x Oreille de Foufayteur.",
        "Prévoir 1 x Huile de Sésame."
      ],
      "actions": [
        {
          "instruction": "Parlez au Capitaine Kradoc pour lancer la quête. Il vous demande plusieurs ressources avant d'accepter de préparer son navire.",
          "position": "[15,28]",
          "zoneHint": "Sufokia",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Réunissez 2 x Miséricorde du Chafer d'Élite, 1 x Gros Boulet, 1 x Oreille de Foufayteur et 1 x Huile de Sésame.",
          "position": null,
          "zoneHint": null,
          "warning": "Les quatre types de ressources sont nécessaires pour terminer la quête.",
          "combat": "NONE"
        },
        {
          "instruction": "Retournez voir le Capitaine Kradoc et donnez-lui toutes les ressources. Il prépare le navire et la quête se termine.",
