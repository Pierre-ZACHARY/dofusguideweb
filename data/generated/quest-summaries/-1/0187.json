  "summaries": [
    {
      "overview": "Poursuivez la quête confiée par Bowisse : récupérez les Champignons Ligneux et la recette des Semelles de Vent, fabriquez les semelles dans son atelier puis suivez la réaction de la boussole jusqu'à Toungousa sur Pandala. Cette séquence mène directement à la piste de Tonam Etanwa et prépare la quête suivante, Le voleur d'âmes.",
      "recommendedLevel": 50,
      "prerequisites": [
        "Avoir la quête en cours après avoir parlé à Bowisse au Village d'Amakna [5,1].",
        "Avoir au moins un métier de niveau 50.",
        "Retourner voir le Dark Vlad, toujours sans mourir."
      ],
      "rewards": [
        "244 518 XP.",
        "4 176 kamas.",
        "2 x Cuir de Bouftou Royal."
      ],
      "preparation": [
        "Prévoir 8 x Graine de la Discorde.",
        "Prévoir 4 x Résine.",
        "Prévoir 10 x Plume du Kwak de Vent.",
        "Prévoir 6 x Ailes de Scarafeuille Blanc.",
        "Prévoir 2 x Pierre d'Émeraude.",
        "Prévoir un combat contre le Cordonnier Sombre accompagné d'un Boulanger Sombre et d'un Mineur Sombre."
      ],
      "actions": [
        {
          "instruction": "Récoltez 10 x Champignon Ligneux dans la clairière de Brouce Boulgoure.",
          "position": null,
          "zoneHint": "Clairière de Brouce Boulgoure",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez au Cordonnier Sombre puis affrontez son groupe afin d'obtenir les Secrets de Fabrication des Semelles de Vent.",
          "position": "[14,17]",
          "zoneHint": null,
          "warning": "Le Cordonnier Sombre est accompagné d'un Boulanger Sombre et d'un Mineur Sombre.",
          "combat": "SOLO"
        },
        {
          "instruction": "Retournez voir Bowisse avec les 10 Champignon Ligneux et les Secrets de Fabrication des Semelles de Vent, puis remettez-les-lui pour apprendre la recette.",
          "position": "[5,1]",
          "zoneHint": "Village d'Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Utilisez l'atelier spécial de Bowisse pour fabriquer les Semelles de Vent avec 8 x Graine de la Discorde, 4 x Résine, 10 x Plume du Kwak de Vent, 6 x Ailes de Scarafeuille Blanc et 2 x Pierre d'Émeraude.",
          "position": "[5,1]",
          "zoneHint": "Village d'Amakna",
          "warning": "Les composants indiqués sont consommés lors de la fabrication.",
          "combat": "NONE"
        },
        {
          "instruction": "Reparlez à Bowisse et donnez-lui les Semelles de Vent afin qu'il vous montre les bottes du Dark Vlad.",
          "position": "[5,1]",
          "zoneHint": "Village d'Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Utilisez la boussole de Mériana dans l'inventaire de quêtes pour faire apparaître la destination [27,-28].",
          "position": null,
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Rendez-vous auprès de Toungousa et interrogez-la au sujet du Dark Vlad.",
          "position": "[27,-28]",
          "zoneHint": "Pandala",
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "Toungousa révèle que le Dark Vlad parlait à l'esprit Tonam Etanwa.",
        "La suite consiste à réunir des âmes pour pouvoir communiquer avec cet esprit ; elle est traitée dans Le voleur d'âmes."
      ],
