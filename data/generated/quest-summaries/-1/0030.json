  "summaries": [
    {
      "overview": "Metag Robill vous envoie rencontrer le Maître des clefs, qui vous fait enchaîner deux donjons. Vous devez vaincre le Chafer Rönin dans le Donjon des Squelettes, revenir chercher la mission suivante, puis vaincre le Batofu dans le Donjon des Tofus. Après un dernier retour au Maître des clefs, rendez-vous auprès de Pat Akess pour terminer la quête et débloquer « Les sbires du maître ».",
      "recommendedLevel": 30,
      "prerequisites": [
        "Être de niveau supérieur à 29.",
        "Avoir terminé « Revenons à nos bouftons »."
      ],
      "rewards": [
        "610 242 XP.",
        "11 424 kamas."
      ],
      "preparation": [
        "Prévoir de terminer 1 x Donjon des Squelettes.",
        "Prévoir de terminer 1 x Donjon des Tofus."
      ],
      "actions": [
        {
          "instruction": "Dans la taverne d’Astrub, parlez à Metag Robill et demandez une nouvelle mission, puis choisissez de vous rendre chez le Maître des clefs.",
          "position": "[6,-18]",
          "zoneHint": "taverne d’Astrub",
          "warning": "Condition : être de niveau supérieur à 29 et avoir terminé « Revenons à nos bouftons ».",
          "combat": "NONE"
        },
        {
          "instruction": "Parlez au Maître des clefs afin de recevoir la clef et l’objectif du prochain donjon.",
          "position": "[-6,-37]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Terminez le Donjon des Squelettes et vainquez le Chafer Rönin.",
          "position": "[10,15]",
          "zoneHint": "Donjon des Squelettes",
          "warning": "Un donjon complet et son combat contre le Chafer Rönin sont obligatoires.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retournez auprès du Maître des clefs pour valider cette étape et recevoir la clef du donjon suivant.",
          "position": "[-6,-37]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Terminez le Donjon des Tofus et vainquez le Batofu.",
          "position": "[5,6]",
          "zoneHint": "Donjon des Tofus",
          "warning": "Un second donjon complet et son combat contre le Batofu sont obligatoires.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retournez voir le Maître des clefs ; il vous dirige alors vers une nouvelle personne.",
          "position": "[-6,-37]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Rencontrez Pat Akess et choisissez « Merci, c’est exactement ce qu’il me faut » pour conclure la mission.",
          "position": "[5,0]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "La quête débloque ensuite « Les sbires du maître »."
      ],
      "npcs": [
        "Metag Robill",
        "Maître des clefs",
        "Pat Akess"
      ],
