    {
      "overview": "Lancez Fantômes contre fantômes auprès d'Hanniboul Smisse, qui vous envoie visiter la Maison Fantôme. Le parcours demande ensuite de rejoindre la Foire du Trool, d'entrer dans le donjon avec une clef ou le trousseau et de vaincre Boostache avant de reparler au Gentil Organisateur Chafer.",
      "recommendedLevel": 40,
      "prerequisites": [
        "Niveau recommandé : 40."
      ],
      "rewards": [
        "254 268 XP.",
        "Attitude : Pleurer."
      ],
      "preparation": [
        "Prévoir 1 x Donjon Maison Fantôme.",
        "Disposer du trousseau de clefs ou d'une clef permettant d'entrer dans la Maison Fantôme."
      ],
      "actions": [
        {
          "instruction": "Parlez à Hanniboul Smisse et acceptez sa proposition de visiter une Maison hantée.",
          "position": "[-1,2]",
          "zoneHint": "Village d'Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Rendez-vous à la Maison Fantôme, parlez au Gentil Organisateur Chafer et entrez dans le donjon avec le trousseau ou la clef. L'accès à la Foire du Trool peut se faire par le bas en [-11,-36].",
          "position": "[-13,-41]",
          "zoneHint": "Foire du Trool",
          "warning": "Une clef ou le trousseau de clefs est nécessaire pour entrer dans le donjon.",
          "combat": "NONE"
        },
        {
          "instruction": "Parcourez le donjon Maison Fantôme et battez Boostache.",
          "position": "[-13,-41]",
          "zoneHint": "Maison Fantôme",
          "warning": "Le donjon doit être terminé pour poursuivre la quête.",
          "combat": "GROUP"
