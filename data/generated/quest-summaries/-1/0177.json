          "zoneHint": "Lande Poilue",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retournez auprès de Patapay et annoncez-lui que Morris devrait venir le voir. Écoutez son témoignage concernant les ennemis potentiels de Charblie.",
          "position": "[3,2]",
          "zoneHint": "Lande Poilue",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Revenez auprès de Chavanna et poursuivez la conversation jusqu'à l'apparition du Matougarou Essoufflé.",
          "position": "[2,0]",
          "zoneHint": "Lande Poilue",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez au Matougarou Essoufflé pour découvrir qu'il s'agit de Charblie, puis rassurez Chavanna afin de terminer la quête.",
          "position": "[2,0]",
          "zoneHint": "Lande Poilue",
          "warning": null,
          "combat": "NONE"
        }
