  "summaries": [
    {
      "overview": "La méditation à Plantala, le combat contre les Moskitos et le suivi de la Lumière dorée jusqu'à l'entrée de la Bambusaie sont supposés déjà accomplis. Reprenez en entrant dans la Bambusaie de Damadrya, puis poursuivez la recherche de l'ambre spirituel jusqu'à sa purification et au retour auprès de l'Esprit serein.",
      "recommendedLevel": 110,
      "prerequisites": [
        "Comme un corbac sur sa branche."
      ],
      "rewards": [
        "3 116 628 XP.",
        "34 272 Kamas.",
        "3 x Truk divin."
      ],
      "preparation": [
        "Avoir progressé jusqu'au moment où la Lumière dorée entre dans la Bambusaie de Damadrya.",
        "Disposer de l'Anneau Ocre confié par Otomaï pour purifier l'Ambre spirituel."
      ],
      "actions": [
        {
          "instruction": "Entrez dans la Bambusaie de Damadrya en suivant la Lumière dorée et vainquez Damadrya.",
          "position": "[26,-30]",
          "zoneHint": "Bambusaie de Damadrya",
          "warning": "Donjon avec combat contre Damadrya.",
          "combat": "GROUP"
        },
        {
          "instruction": "Avant de quitter le donjon, parlez à Damadrya et choisissez de retrouver peu à peu votre calme après la frénésie des combats. Écoutez ses indications sur l'ami des Plantalas à ramener sur sa terre natale.",
          "position": null,
          "zoneHint": "Bambusaie de Damadrya",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Placez-vous à côté de la Lumière dorée et interagissez avec elle pour avancer dans la lumière et être transporté vers le Bois de Litneg.",
          "position": null,
          "zoneHint": "Bambusaie de Damadrya",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Rendez-vous à la sépulture en [-14,-59], parlez au Trooll profanateur et envoyez les trois monstres en Externam.",
          "position": "[-14,-59]",
          "zoneHint": "Bois de Litneg",
          "warning": "Un combat contre les Troolls se déclenche et peut être réalisé en groupe.",
          "combat": "GROUP"
        },
        {
          "instruction": "Après le combat, parlez au Fantôme déraciné, puis placez-vous près de la Pousse apparue et parlez au Pousse de bambou afin de l'emporter vers Pandala.",
          "position": "[-14,-59]",
          "zoneHint": "Bois de Litneg",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retournez devant la source spirituelle de Plantala et cliquez sur la statue Pandawa en bas à droite pour enterrer le pousse.",
          "position": "[24,-35]",
          "zoneHint": "Plantala",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à l'Âme renaissante afin qu'elle transforme la Lumière dorée en Ambre spirituel.",
          "position": "[24,-35]",
          "zoneHint": "Plantala",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Équipez l'Anneau Ocre à la place de l'un de vos anneaux, puis double-cliquez sur l'Ambre spirituel dans l'inventaire de quête afin d'obtenir 1 x Ambre jaune purifié.",
          "position": "[24,-35]",
          "zoneHint": "Plantala",
          "warning": "L'Anneau Ocre doit être équipé avant d'utiliser l'Ambre spirituel.",
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à l'Esprit serein et rassurez-le en expliquant que les trois ambres permettront de renouveler le serment de Terrakourial et d'empêcher le mal de la forêt maléfique de s'échapper.",
          "position": "[24,-35]",
          "zoneHint": "Plantala",
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "La quête se termine après l'échange avec l'Esprit serein.",
        "En continuant la conversation avec l'Esprit serein, la quête Pas de fumée sans feu devient disponible."
      ],
