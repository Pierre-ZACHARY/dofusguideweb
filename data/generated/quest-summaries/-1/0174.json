    {
      "overview": "Après avoir terminé À la poursuite d'Octolliard rouge, infiltre le passage secret menant à Turorte avec une Fourbacoiffe et une Bouteille de Gloutoburg, échange le bandana contre l'accès à la corne, puis traverse les souterrains, bats seul le Iop brâkmarien et rapporte la Corne Edfrit à Amayiro. Un sombre pouvoir ne doit être commencé qu'à l'étape suivante.",
      "recommendedLevel": 158,
      "prerequisites": [
        "Avoir terminé À la poursuite d'Octolliard rouge."
      ],
      "rewards": [
        "5 443 559 XP."
      ],
      "preparation": [
        "Prévoir 1 x Fourbacoiffe.",
        "Prévoir 1 x Bouteille de Gloutoburg.",
        "Pour fabriquer la Bouteille de Gloutoburg : 5 x Pandaburg, 1 x Glouto Rhum et 10 x Feuille de Salace.",
        "Les Pandaburg peuvent être achetés à la taverne en [20,-29].",
        "Prévoir 1 x combat obligatoire en solo."
      ],
      "actions": [
        {
          "instruction": "Rends-toi en [31,8], équipe la Fourbacoiffe et utilise 1 x Bouteille de Gloutoburg.",
          "position": "[31,8]",
          "zoneHint": null,
          "warning": "La Fourbacoiffe doit être équipée et la Bouteille de Gloutoburg consommée pour poursuivre.",
          "combat": "NONE"
        },
        {
          "instruction": "Utilise le passage secret en cliquant sur la case située à droite derrière l'arbre, puis parle à Turorte et propose son bandana en échange de la Corne Edfrit.",
          "position": "[31,8]",
          "zoneHint": "Passage secret",
          "warning": "Le bandana est échangé à Turorte afin d'obtenir l'accès vers la corne.",
          "combat": "NONE"
        },
        {
          "instruction": "Va en [32,4] et clique sur la case cachée derrière le tronc pour descendre dans le passage secret.",
          "position": "[32,4]",
          "zoneHint": "Passage secret",
          "warning": null,
          "combat": "NONE"
