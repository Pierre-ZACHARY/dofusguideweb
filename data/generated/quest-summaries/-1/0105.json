          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez à Sionverin et prenez connaissance de sa demande : récupérer 5 x Bave infectée et 5 x Croc infecté dans les Hauts des Hurlements.",
          "position": "[-27,-2]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Combattez les monstres des Hauts des Hurlements jusqu'à obtenir 5 x Bave infectée sur Cocholou ou Mulounoké et 5 x Croc infecté sur Mergranlou ou Mulou.",
          "position": null,
          "zoneHint": "Hauts des Hurlements",
          "warning": "Ces objets sont des ressources de quête non achetables en hôtel de vente et ont un taux de base de 10%.",
          "combat": "GROUP"
