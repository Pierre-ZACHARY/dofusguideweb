  "summaries": [
    {
      "overview": "Reprenez après Énergie renouvelable auprès du Doc Emiette Borgne. Il faut libérer le Maître des zaaps, d'abord avec l'Électrofoudre puis avec le Marteau Chronomagique, vaincre le Maître des zaaps en combat solo et rapporter la Batterie Éternelle au Major Qiu.",
      "recommendedLevel": 100,
      "prerequisites": [
        "Énergie renouvelable."
      ],
      "rewards": [
        "2 625 000 XP.",
        "43 980 Kamas."
      ],
      "preparation": [
        "Prévoir 1 combat seul.",
        "Avoir accès au Xélorium et disposer des montres permettant de changer de période."
      ],
      "actions": [
        {
          "instruction": "Parlez au Doc Emiette Borgne à la suite de la quête précédente et récupérez l'Électrofoudre destiné au Maître des zaaps.",
          "position": "[1,6]",
          "zoneHint": "Chemins d'hier",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Équipez l'Électrofoudre dans votre emplacement de corps-à-corps.",
          "position": "[1,6]",
          "zoneHint": "Chemins d'hier",
          "warning": "L'Électrofoudre doit être équipé au corps-à-corps pour être utilisé.",
          "combat": "NONE"
        },
        {
          "instruction": "Sortez du bâtiment en [1,6], utilisez la Montre en avance puis rejoignez le temple où se trouve le Maître des zaaps.",
          "position": "[1,6]",
          "zoneHint": "Jour présent",
          "warning": "Utilisez la montre en dehors des bâtiments.",
          "combat": "NONE"
        },
        {
          "instruction": "Parlez au Maître des zaaps et utilisez sur elle l'Électrofoudre équipé au corps-à-corps.",
          "position": null,
          "zoneHint": "Jour présent",
          "warning": "La tentative échoue : vous recevez la malédiction Enfumage et plusieurs doubles du Maître des zaaps apparaissent.",
          "combat": "NONE"
        },
        {
          "instruction": "Parlez au Krosmoglob du Doc et refusez la solution expérimentale proposée afin que le Doc vous conseille d'éliminer les doubles avec un marteau.",
          "position": null,
          "zoneHint": "Jour présent",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Récupérez le Marteau Chronomagique transmis par le Krosmoglob et équipez-le au corps-à-corps.",
          "position": null,
          "zoneHint": "Jour présent",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Frappez les Maîtres des zaaps avec le Marteau Chronomagique en commençant par le double apparu le plus récemment et en remontant jusqu'à l'originale. Chaque coup fournit une Poudre Chronanomalie.",
          "position": null,
          "zoneHint": "Jour présent",
          "warning": "La source fournie renvoie à une illustration pour l'ordre visuel précis des doubles et ne donne pas cet ordre sous forme textuelle.",
          "combat": "NONE"
        },
        {
          "instruction": "Après avoir supprimé les doubles, affrontez le Maître des zaaps.",
          "position": null,
          "zoneHint": "Jour présent",
          "warning": "Le combat s'effectue seul. Le Maître des zaaps peut notamment se téléporter, voler de la portée et retourner des dommages.",
          "combat": "SOLO"
        },
        {
          "instruction": "Après la victoire, reparlez au Maître des zaaps et racontez-lui ce qui vient de se produire afin de recevoir la Batterie Éternelle.",
          "position": null,
          "zoneHint": "Jour présent",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Quittez le Xélorium et rendez-vous à la Tour des Voyageurs en [-22,-24].",
          "position": "[-22,-24]",
          "zoneHint": "Routes Rocailleuses",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Parlez au Major Qiu et remettez-lui la Batterie Éternelle pour terminer Traitement de choc.",
          "position": "[-22,-24]",
          "zoneHint": "Routes Rocailleuses",
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "Cette occurrence reprend directement après Énergie renouvelable.",
        "La fin de la quête achève également le succès Générations futures."
      ],
      "npcs": [
        "Doc Emiette Borgne",
        "Maître des zaaps",
        "Krosmoglob du Doc",
        "Major Qiu"
      ],
