    {
      "overview": "Aidez Soki, un chacha déprimé, en lui apportant à manger, en lui faisant visiter plusieurs endroits d’Astrub puis en lui donnant l’occasion d’impressionner une chachatte rose grâce à une Sousouris capturée dans une cave.",
      "recommendedLevel": 15,
      "prerequisites": [],
      "rewards": [
        "10 378 XP.",
        "252 kamas.",
        "4 x Plume de Piou Rose."
      ],
      "preparation": [
        "Prévoir 1 x Lailait.",
        "Prévoir 1 x Goujon.",
        "Prévoir 1 x combat, réalisable en groupe."
      ],
      "actions": [
        {
          "instruction": "Parlez à Soki, caressez le chacha puis décidez de lui apporter un Goujon et un Lailait pour tenter de lui remonter le moral.",
          "position": "[7,-20]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Procurez-vous 1 x Lailait et 1 x Goujon. Le Lailait peut être acheté à la taverne pour 4 kamas ; le Goujon peut être acheté ou pêché.",
          "position": "[6,-18]",
          "zoneHint": "Taverne d'Astrub",
          "warning": "L’achat du Lailait à la taverne coûte 4 kamas ; le prix éventuel du Goujon dépend de son mode d’obtention.",
          "combat": "NONE"
        },
        {
          "instruction": "Retournez auprès de Soki et donnez-lui le Lailait et le Goujon.",
          "position": "[7,-20]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Emmenez Soki visiter la place du Temple des Douze.",
          "position": "[6,-19]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Emmenez ensuite Soki devant l’hôtel de vente des consommables.",
          "position": "[3,-19]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Poursuivez la promenade devant la boutique de Kerubim.",
          "position": "[3,-17]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Terminez les quatre visites devant l’hôtel de vente des équipements.",
          "position": "[6,-17]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Ramenez Soki à son point de départ et constatez qu’il reste déprimé ; il cherche en réalité à impressionner la chachatte rose.",
          "position": "[7,-20]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Descendez à la maison située sur la gauche puis entrez et gagnez la cave.",
          "position": "[7,-19]",
          "zoneHint": "Cave de la maison",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Dans la cave, parlez à l’une des Sousouris et attaquez-la.",
          "position": "[7,-19]",
          "zoneHint": "Cave de la maison",
          "warning": "Combat réalisable en groupe.",
          "combat": "GROUP"
        },
        {
          "instruction": "Après le combat, revenez auprès de Soki et donnez-lui la Sousouris afin qu’il puisse impressionner la chachatte rose.",
          "position": "[7,-20]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        }
