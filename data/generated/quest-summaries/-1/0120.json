  "summaries": [
    {
      "overview": "À cette occurrence, avancez Les monologues du vaccin jusqu'à son terme, mais respectez l'arrêt demandé autour de La Bête : complétez d'abord les échantillons de sang de boufmouth manquants, poursuivez les démarches d'Albert Paisse jusqu'au combat contre La Bête, récupérez son échantillon sans le remettre immédiatement, puis obtenez Le Rube sur des monstres avant de terminer la quête. Conservez impérativement Le Rube pour pouvoir lancer ensuite Le mal a dit.",
      "recommendedLevel": 120,
      "prerequisites": [
        "Niveau recommandé par la source : 100-120.",
        "Prévoir des combats contre des Boufmouths dans les Champs de glace.",
        "Prévoir l'aide de 3 personnages pour ouvrir le passage vers La Bête."
      ],
      "rewards": [
        "2 047 500 XP.",
        "23 960 kamas.",
        "Vaccin contre le rube temporaire pendant 7 jours."
      ],
      "preparation": [
        "Avoir terminé le donjon mentionné par le parcours avant de reprendre cette portion.",
        "Prévoir un groupe si nécessaire pour le combat contre La Bête.",
        "Ne pas remettre immédiatement l'Echantillon de sang de La Bête à Albert Paisse après le combat."
      ],
      "actions": [
        {
          "instruction": "Dans les Champs de glace, combattez des Boufmouths jusqu'à compléter les 6 échantillons de sang de boufmouth demandés, en ne récupérant ici que ceux qui vous manquent encore.",
          "position": null,
          "zoneHint": "Champs de glace",
          "warning": null,
          "combat": "GROUP"
        },
        {
          "instruction": "Rapportez les 6 échantillons à Albert Paisse.",
          "position": "[-80,-45]",
          "zoneHint": "La Bourgade",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez voir le Capitaine Gneux et demandez l'eau de mer isotonique. Il exige de l'armoise en échange.",
          "position": "[-85,-36]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Demandez de l'armoise à Éric Azaraille. Après son refus, épuisez la discussion afin d'apprendre qu'il attend des excuses de Gneux.",
          "position": "[-81,-44]",
          "zoneHint": "La Bourgade",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retournez auprès de Gneux, annoncez le refus d'Éric et choisissez une tranche horaire pour leur rendez-vous.",
          "position": "[-85,-36]",
          "zoneHint": null,
          "warning": "Le choix de la tranche horaire conditionne la suite. Si l'horaire choisi ne convient pas, son changement n'est possible qu'après 24 heures.",
          "combat": "NONE"
        },
        {
          "instruction": "Pendant la tranche horaire choisie, rendez-vous à la Taverne du Paradis Frigostien, parlez à Gneux et poursuivez la conversation jusqu'à avoir bu avec lui.",
          "position": "[-77,-38]",
          "zoneHint": "Taverne du Paradis Frigostien",
          "warning": "Cette étape doit être effectuée pendant la tranche horaire enregistrée dans l'objet de quête.",
          "combat": "NONE"
        },
        {
          "instruction": "Retournez voir Éric Azaraille après les excuses de Gneux afin de récupérer l'armoise.",
          "position": "[-81,-44]",
          "zoneHint": "La Bourgade",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Remettez l'armoise au Capitaine Gneux afin d'obtenir l'eau de mer isotonique.",
          "position": "[-85,-36]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Apportez l'eau de mer isotonique à Albert Paisse, puis acceptez de vous occuper de son cobaye.",
          "position": "[-80,-45]",
          "zoneHint": "La Bourgade",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Descendez dans la cave et faites placer 3 personnages sur les emplacements nécessaires afin d'ouvrir la grille. Franchissez-la pour obtenir le Sortilège d'Albert Paisse.",
          "position": "[-80,-45]",
          "zoneHint": "Cave",
          "warning": "L'aide de 3 personnages est nécessaire pour ouvrir le passage.",
          "combat": "NONE"
        },
        {
          "instruction": "Affrontez La Bête. Lancez impérativement le Sortilège d'Albert Paisse sur La Bête avant de la tuer, puis remportez le combat afin d'obtenir l'Echantillon de sang de La Bête.",
          "position": "[-80,-45]",
          "zoneHint": "Cave",
          "warning": "Si La Bête meurt sans avoir reçu le Sortilège d'Albert Paisse, son effet peut tuer toute l'équipe. Son poison peut aussi frapper la cible et les personnages à son corps-à-corps au début de son tour.",
          "combat": "GROUP"
        },
        {
          "instruction": "Après le combat, gardez temporairement l'Echantillon de sang de La Bête au lieu de le remettre tout de suite à Albert Paisse, puis combattez les monstres requis jusqu'à obtenir Le Rube.",
          "position": null,
          "zoneHint": null,
          "warning": "Ne rendez pas encore l'Echantillon de sang de La Bête avant d'avoir obtenu Le Rube.",
          "combat": "GROUP"
        },
        {
          "instruction": "Revenez ensuite auprès d'Albert Paisse et remettez l'Echantillon de sang de La Bête pour terminer la quête.",
          "position": "[-80,-45]",
          "zoneHint": "La Bourgade",
          "warning": "Conservez Le Rube après la fin de la quête : il est nécessaire pour pouvoir lancer Le mal a dit.",
          "combat": "NONE"
        }
      ],
      "notes": [
