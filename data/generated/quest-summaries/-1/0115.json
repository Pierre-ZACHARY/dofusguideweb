  "summaries": [
    {
      "overview": "Mériana vous met sur la piste du Livre des Taures, nécessaire pour poursuivre la recherche du Dofus Pourpre. Il faut interroger successivement plusieurs bibliothécaires à Bonta, Brakmar, Sufokia, Amakna, Pandala puis Astrub. Après une attaque de roublards à Astrub, retournez auprès de Mériana, puis partez à la Bibliothèque du Maître Corbac pour obtenir le Livre des Taures ainsi qu'un Os avant de les lui rapporter.",
      "recommendedLevel": 110,
      "prerequisites": [
        "La magicienne des marécages."
      ],
      "rewards": [
        "3 116 628 XP.",
        "34 272 kamas.",
        "3 x Tissu Sombre."
      ],
      "preparation": [
        "Prévoir 1 combat seul.",
        "Prévoir 1 passage dans le donjon Bibliothèque du Maitre Corbac."
      ],
      "actions": [
        {
          "instruction": "Parlez à Mériana au sujet du Dofus Pourpre. Elle vous demande de rechercher le Livre des Taures.",
          "position": "[-6,-3]",
          "zoneHint": "Marécages nauséabonds",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Rendez-vous à la bibliothèque de Bonta et interrogez Marcelle Rouste au sujet du Livre des Taures.",
          "position": "[-35,-57]",
          "zoneHint": "Bonta",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez à la bibliothèque de Brakmar et demandez à Jean-Sol Patre des informations sur le Livre des Taures.",
          "position": "[-24,39]",
          "zoneHint": "Brakmar",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Rendez-vous à Sufokia et questionnez le Docteur Hou à propos du Livre des Taures.",
          "position": "[20,25]",
          "zoneHint": "Sufokia",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez à la bibliothèque d'Amakna et parlez à Harry Stote. Il vous oriente vers Astrub.",
          "position": "[4,1]",
          "zoneHint": "Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Avant Astrub, faites un détour par Pandala et interrogez Narber Rihen Levihawa au sujet du grimoire.",
          "position": "[21,-27]",
          "zoneHint": "Pandala",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Rendez-vous dans le grenier de la bibliothèque d'Astrub et parlez à Oz Dralett. Il vous indique que le Livre des Taures se trouve dans la Bibliothèque du Maître Corbac, puis des roublards vous attaquent.",
          "position": "[7,-19]",
          "zoneHint": "Astrub",
          "warning": "Le combat s'effectue seul. Une défaite n'empêche pas la quête de se mettre à jour.",
          "combat": "SOLO"
        },
        {
          "instruction": "Retournez voir Mériana et reparlez-lui du Maître Corbac. Elle vous demande de terrasser le Maître Corbac et de lui rapporter également un Os.",
          "position": "[-6,-3]",
          "zoneHint": "Marécages nauséabonds",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Partez dans la Bibliothèque du Maitre Corbac et accomplissez le donjon afin d'obtenir le Livre des Taures. Assurez-vous également d'avoir l'Os demandé par Mériana.",
          "position": "[-15,-62]",
          "zoneHint": "Bibliothèque du Maitre Corbac",
          "warning": "Passage en donjon et combat contre le Maître Corbac requis.",
          "combat": "GROUP"
        },
        {
          "instruction": "Lorsque vous possédez le Livre des Taures et l'Os, retournez auprès de Mériana et remettez-lui les deux objets pour terminer la quête.",
          "position": "[-6,-3]",
          "zoneHint": "Marécages nauséabonds",
          "warning": null,
          "combat": "NONE"
        }
      ],
      "notes": [
        "Pour rejoindre Mériana en [-6,-3], la source mentionne le chemin vers Mériana.",
        "Après cette quête, poursuivre la discussion avec Mériana permet d'obtenir Taures et détours."
      ],
