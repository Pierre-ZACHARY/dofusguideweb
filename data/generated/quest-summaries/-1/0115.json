      "prerequisites": [],
      "rewards": [
        "1 298 594 XP",
        "14 280 kamas",
        "10 x Coeur de Brandon"
      ],
      "preparation": [
        "40 x Sauge",
        "5 x Patte de Corbac",
        "5 x Plume de Buveur",
        "5 x Poil de Renarbo",
        "50 x Bois de Bombu",
        "5 x Plume de Corbac Apprivoisé"
      ],
      "actions": [
        {
          "instruction": "Allez aux Pénates du Corbac et parlez à Natacha Manka. Elle vous explique avoir perdu son sac de soins lors d'un combat contre les créatures des environs.",
          "position": "[-12,-60]",
          "zoneHint": "Pénates du Corbac",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez récupérer le Sac de Natacha Manka en cliquant sur le sac à côté du puits.",
          "position": "[-13,-61]",
          "zoneHint": "Pénates du Corbac",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retournez voir Natacha Manka et donnez-lui son sac ainsi que 40 x Sauge. Questionnez-la sur les raisons de sa présence.",
          "position": "[-12,-60]",
          "zoneHint": "Pénates du Corbac",
          "warning": "Dépense : 40 x Sauge.",
          "combat": "NONE"
        },
        {
          "instruction": "Récupérez 3 x Bois de Corbac en cliquant sur les troncs d'arbre aux trois positions indiquées.",
          "position": "[-15,-60], [-12,-62], [-14,-62]",
          "zoneHint": "Pénates du Corbac",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Ramenez le Bois de Corbac à Natacha Manka. Elle vous demande de l'aider à tailler des rondins enchantés.",
          "position": "[-12,-60]",
          "zoneHint": "Pénates du Corbac",
          "warning": null,
          "combat": "NONE"
        }
