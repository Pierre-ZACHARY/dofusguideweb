      "prerequisites": [
        "Avoir terminé La magicienne des marécages."
      ],
      "rewards": [
        "3 116 628 XP à la fin de la quête.",
        "34 272 kamas à la fin de la quête.",
        "3 x Tissu Sombre à la fin de la quête."
      ],
      "preparation": [
        "Prévoir un combat en solo pendant l'enquête à Astrub.",
