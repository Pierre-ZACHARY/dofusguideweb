    {
      "overview": "Mériana vous révèle que le Dofus Pourpre est gardé par le Minotoror. Pour vous en emparer, il vous faut le Livre des Taures. Elle ignore où en trouver, vous devez donc faire le tour des bibliothèques de Bonta, Brakmar, Sufokia, Amakna, Pandala et Astrub pour en dénicher un exemplaire avant d'affronter le Donjon Bibliothèque du Maitre Corbac.",
      "recommendedLevel": 110,
      "prerequisites": [
        "La magicienne des marécages"
      ],
      "rewards": [
        "3 116 628 XP",
        "34 272 kamas",
        "3 x Tissu Sombre"
      ],
      "preparation": [
        "1 x combat (seul)",
        "1 x Donjon Bibliothèque du Maitre Corbac"
      ],
      "actions": [
        {
          "instruction": "Allez en [-6,-3] aux Marécages nauséabonds et parlez à Mériana du Dofus Pourpre.",
          "position": "[-6,-3]",
          "zoneHint": "Marécages nauséabonds",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez à la bibliothèque de Bonta en [-35,-57] et parlez à Marcelle Rouste du Livre des Taures.",
          "position": "[-35,-57]",
          "zoneHint": "Bonta",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez à Brakmar en [-24,39] et parlez à Jean-Sol Patre du Livre des Taures.",
          "position": "[-24,39]",
          "zoneHint": "Brakmar",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez à Sufokia en [20,25] et parlez au Docteur Hou du Livre des Taures.",
          "position": "[20,25]",
          "zoneHint": "Sufokia",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez à la bibliothèque d'Amakna pour chercher le Livre des Taures.",
          "position": null,
          "zoneHint": "Amakna",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez à la bibliothèque de Pandala pour chercher le Livre des Taures.",
          "position": null,
          "zoneHint": "Pandala",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Allez à la bibliothèque d'Astrub pour chercher le Livre des Taures.",
          "position": null,
          "zoneHint": "Astrub",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Affrontez le Donjon Bibliothèque du Maitre Corbac en combat seul.",
          "position": null,
          "zoneHint": null,
          "warning": "Combat en solo obligatoire.",
          "combat": "SOLO"
        }
      ],
      "notes": [
