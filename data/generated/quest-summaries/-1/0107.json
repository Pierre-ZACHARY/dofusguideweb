    {
      "overview": "Enquête sur la disparition d'un marchand de vin à Bonta. Parlez aux témoins, suivez la piste d'une Épée étrange, puis affrontez le Rat Blanc dans son donjon pour récupérer le Grelot d'Hersa et obtenir des informations.",
      "recommendedLevel": 111,
      "prerequisites": [
        "Quête « C'est stupéfiant » terminée"
      ],
      "rewards": [
        "6 334 872 XP"
      ],
      "preparation": [
        "1 x Donjon des Rats de Bonta (accès requis)"
      ],
      "actions": [
        {
          "instruction": "Se rendre à la Milice en [-32,-57] et parler à Amayiro. Il vous informe de la disparition du marchand de vin et vous charge d'enquêter.",
          "position": "[-32,-57]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Aller à la Taverne de la Bagrutte en [-29,-59] et parler à Bagrutta Ventrepierre. Elle vous apprend que le marchand est rentré chez lui vers l'Est après son passage.",
          "position": "[-29,-59]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Sortir de la taverne et parler à Tertofi Ablaru qui vous interpelle. Il vous montre des traces de combat et une Épée étrange trouvée sur les lieux.",
          "position": null,
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Se rendre à l'atelier des forgerons en [-30,-56] et montrer l'Épée étrange à Kosuke Ichazum. Il identifie l'arme comme appartenant probablement à un Ecaflip.",
          "position": "[-30,-56]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Aller à la sortie Sud de Bonta en [-30,-53] et parler à Hersa Griffe Sombre. Elle accepte de partager ses informations en échange de la récupération de son grelot, volé par les sbires du Rat Blanc.",
          "position": "[-30,-53]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Entrer dans les égouts par l'accès en [-32,-58] ou [-35,-55].",
          "position": "[-32,-58]",
          "zoneHint": "Égouts",
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Entrer dans le Donjon des Rats de Bonta en [-34,-59], vaincre le Rat Blanc et récupérer le Grelot d'Hersa.",
          "position": "[-34,-59]",
          "zoneHint": "Donjon des Rats de Bonta",
          "warning": "Combat de groupe contre le Rat Blanc. Nécessite l'accès au Donjon des Rats de Bonta.",
          "combat": "GROUP"
        },
        {
          "instruction": "Retourner voir Hersa Griffe Sombre en [-30,-53] et lui rapporter le Grelot d'Hersa. Elle vous révèle avoir déjà vu des Ecaflips étrangers à Bonta posséder ce type d'épée.",
          "position": "[-30,-53]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        },
        {
          "instruction": "Retourner voir Amayiro en [-32,-57] et lui résumer les éléments recueillis pour terminer la quête.",
          "position": "[-32,-57]",
          "zoneHint": null,
          "warning": null,
          "combat": "NONE"
        }
