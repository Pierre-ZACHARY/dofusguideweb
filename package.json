{
  "name": "dofusguide-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Archiveur respectueux des donnees publiques du guide DofusGuide",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "audit-data": "tsx src/auditDataCli.ts",
    "build": "npm run build:cli && npm run web:build",
    "build:cli": "tsc -p tsconfig.build.json",
    "dev": "vite dev --host 127.0.0.1 --port 3001",
    "predev": "npm run generate-web-content && wrangler d1 migrations apply dofusguideweb-users --local",
    "guides": "tsx src/cli.ts guides",
    "generate-web-content": "tsx src/generateStaticContentCli.ts",
    "import-db": "tsx src/importDbCli.ts",
    "query": "tsx src/queryCli.ts",
    "scrape": "tsx src/cli.ts scrape",
    "scrape-challenges": "tsx src/scrapeChallengesCli.ts",
    "scrape-breeds": "tsx src/scrapeBreedsCli.ts",
    "scrape-dofus": "tsx src/scrapeDofusCli.ts",
    "scrape-bestiary": "tsx src/scrapeBestiaryCli.ts",
    "query-bestiary": "tsx src/queryBestiaryCli.ts",
    "scrape-world-tour": "tsx src/scrapeWorldTourCli.ts",
    "summarize-quests": "tsx src/summarizeQuestsCli.ts",
    "serve": "tsx src/serverCli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web:build": "npm run generate-web-content && vite build",
    "web:build:node": "npm run generate-web-content && vite build --config vite.node.config.ts",
    "cloudflare:preview": "vite preview --host 127.0.0.1 --port 3001",
    "cloudflare:typegen": "wrangler types",
    "web:start": "node .output/server/index.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.17.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "daisyui": "^5.7.22",
    "jsdom": "^26.1.0",
    "nitro": "^3.0.1-alpha.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/start-server-core": "^1.169.31",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "lucide-react": "^0.468.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
