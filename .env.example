# Base documentaire du site. L’image Docker embarque la version suivie dans Git.
DOFUSGUIDE_DB=data/dofusguide.sqlite

# OAuth 2.0 Web client ID créé dans Google Cloud Console.
GOOGLE_CLIENT_ID=

# Clé AES-256 utilisée uniquement côté serveur pour chiffrer les clés API MetaMob.
# Génération PowerShell : [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
METAMOB_CREDENTIALS_KEY=

# Base séparée des archives et de la base reconstruite par import-db.
DOFUSGUIDE_USER_DB=data/user-data.sqlite

# Optionnel : URL PostgreSQL externe pour la base comptes (prioritaire sur DOFUSGUIDE_USER_DB).
# Exemple Docker Compose: postgresql://dofusguide:dofusguide@db:5432/dofusguide_user
DOFUSGUIDE_USER_DATABASE_URL=
